{
  "name": "@vue-ds/tokens",
  "version": "1.0.0",
  "description": "Design tokens for Vue Design System",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./colors.json": "./src/colors.json",
    "./typography.json": "./src/typography.json",
    "./spacing.json": "./src/spacing.json",
    "./shadows.json": "./src/shadows.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
