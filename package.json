{
  "name": "agentic-design-system",
  "version": "1.0.0",
  "private": true,
  "description": "Agentic Design System - Vue 3 Design System Documentation",
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "build:tokens": "cd packages/tokens && pnpm build",
    "build:components": "cd packages/components && pnpm build",
    "build:docs": "cd packages/docs && pnpm build",
    "lint": "eslint . --ext .vue,.js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "type-check": "vue-tsc --noEmit"
  },
  "keywords": [
    "vue",
    "design-system",
    "documentation",
    "ui",
    "components"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.19",
    "@vueuse/core": "^10.11.0",
    "clsx": "^2.0.0",
    "fuse.js": "^7.0.0",
    "remixicon": "^4.6.0",
    "shiki": "^1.10.0",
    "tailwind-merge": "^2.2.2",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.0",
    "vite-plugin-vue-devtools": "^7.0.25",
    "vue-tsc": "^1.8.0"
  },
  "type": "module"
}